# RLS-enforced role used by the API (NOSUPERUSER, NOBYPASSRLS)
DATABASE_URL=postgresql+asyncpg://propsaas_app:app_pw@localhost:5432/propsaas
# BYPASSRLS role used ONLY by Celery workers / ops scripts (cross-tenant sweeps)
DATABASE_URL_SYSTEM=postgresql+asyncpg://propsaas_system:system_pw@localhost:5432/propsaas
# Table owner, used ONLY by Alembic
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://propsaas_owner:owner_pw@localhost:5432/propsaas
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-64-random-bytes
API_SECRET_PEPPER=change-me-to-another-64-random-bytes
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOKIE_ENCRYPTION_KEY=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
# Media library (optional; these are the defaults)
MEDIA_ROOT=media_store
MAX_IMAGE_MB=15
MAX_VIDEO_MB=300
MEDIA_QUOTA_MB=5000

# Business self-registration at /register/: approval | open | closed
REGISTRATION_MODE=approval
# How long a super admin "sign in as business" support session lasts
SUPPORT_SESSION_MINUTES=60
