# RLS-enforced role used by the API (NOSUPERUSER, NOBYPASSRLS)
DATABASE_URL=postgresql+asyncpg://propsaas_app:app_pw@localhost:5432/propsaas

# BYPASSRLS role used ONLY by Celery workers / ops scripts (cross-tenant sweeps)
DATABASE_URL_SYSTEM=postgresql+asyncpg://propsaas_system:system_pw@localhost:5432/propsaas

# Table owner, used ONLY by Alembic
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://propsaas_owner:owner_pw@localhost:5432/propsaas
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-64-random-bytes
API_SECRET_PEPPER=change-me-to-another-64-random-bytes

